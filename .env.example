# Lido direto pelo Spring (spring.config.import em application.properties), sem
# precisar de "source .env". Sem aspas nos valores: elas entrariam no valor. Espaco
# escapa com barra (Suporte\ BV2), o que funciona tambem no bash.
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
JWT_SECRET=
JWT_EXPIRACAO_MINUTOS=

# Usuario MASTER semeado na migration V9. Ver CLAUDE.md > Credenciais de teste.
MASTER_EMAIL=
MASTER_SENHA=

# Webhook do n8n que repassa a notificacao ao WhatsApp. Em branco = integracao
# desligada. O token vai no header X-BV2-Token e casa com a credencial Header
# Auth do node Webhook. Ver CLAUDE.md > Notificacoes.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT_SEGUNDOS=

# E-mail de recuperacao de senha. MAIL_USERNAME e o endereco completo
# (suporte@bv2.tech) e MAIL_PASSWORD e a senha da caixa postal no hPanel da
# Hostinger — nao ha App Password como no Gmail. Em branco = envio desligado.
# Porta 465 usa SSL (MAIL_SSL=true / MAIL_STARTTLS=false); a 587 e o inverso.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=
MAIL_STARTTLS=
MAIL_FROM=
MAIL_FROM_NOME=

# Base dos links enviados por e-mail e validade de cada token, em minutos.
APP_FRONTEND_URL=
RECUPERACAO_SENHA_EXPIRACAO_MINUTOS=
ALTERACAO_EMAIL_EXPIRACAO_MINUTOS=
